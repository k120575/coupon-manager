{
  "name": "coupon-manager-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute coupon-manager --local --file=./migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute coupon-manager --remote --file=./migrations/0001_initial.sql",
    "db:query": "wrangler d1 execute coupon-manager --remote --command",
    "import": "tsx scripts/import-from-csv.ts",
    "richmenu": "tsx scripts/setup-richmenu.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.84.1"
  }
}
